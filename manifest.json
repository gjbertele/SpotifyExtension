{
    "manifest_version": 3,
    "name": "Spotify Extension",
    "version": "1.0",
    "description": "",
    "action": {
      "default_popup": "popup.html",
      "default_icon": "spotify.png"
    },
    "permissions": [
      "activeTab",
      "storage"
    ],
    "content_scripts": [
        {
          "js": ["spotify.js","content.js"],
          "matches": [
            "https://open.spotify.com/*",
            "https://open.spotify.com/*"
          ],
          "run_at":"document_start"
        }
      ],
    "web_accessible_resources":[
        {
            "resources":[
                "inject.js",
                "spotifyController.js",
                "addons.js"
            ],
            "matches":[
                "<all_urls>",
                "<all_urls>",
                "<all_urls>"
            ]
        }
    ]
  }