{
    "manifest_version": 3,
    "name": "Spotify Extension",
    "version": "1.0",
    "description": "",
    "permissions": [
      "activeTab",
      "storage"
    ],
    "content_scripts": [
        {
          "js": ["contentMessaging.js","spotify.js","content.js"],
          "matches": [
            "https://open.spotify.com/*",
            "https://open.spotify.com/*",
            "https://open.spotify.com/*"
          ],
          "run_at":"document_start"
        }
      ],
    "web_accessible_resources":[
        {
            "resources":[
                "inject.js",
                "spotifyController.js",
                "addons.js",
                "injectMessaging.js",
                "playerPatch.js",
                "lyricsPatch.js",
                "searchPatch.js",
                "genreList.js"
            ],
            "matches":[
                "<all_urls>",
                "<all_urls>",
                "<all_urls>",
                "<all_urls>",
                "<all_urls>",
                "<all_urls>",
                "<all_urls>",
                "<all_urls>"
            ]
        }
    ]
  }